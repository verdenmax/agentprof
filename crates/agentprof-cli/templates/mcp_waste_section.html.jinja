{# Reused by both `analyze --section mcp-waste --export html` and the
   future mcp-waste subcommand single-session HTML emission. #}
<section id="mcp-waste">
  <h2>MCP Server Waste</h2>
  <p>
    <strong>Data source:</strong> {{ data_source }}<br>
    <strong>Loaded:</strong> {{ total_loaded }} tools / {{ server_count }} servers,
      {{ total_loaded_tokens }} tokens ({{ provenance_label }}, {{ tokenizer_label }})<br>
    <strong>Unused:</strong> {{ total_unused }} tools, {{ total_unused_tokens }} tokens —
      {{ fully_unused_count }} fully-unused server(s)
  </p>
  <h3>Per-server</h3>
  <table>
    <thead><tr><th>Server</th><th class="num">Loaded</th><th class="num">Called</th><th class="num">Unused</th><th class="num">Unused tokens</th><th>Fully unused?</th></tr></thead>
    <tbody>
      {% for sw in server_waste %}
      <tr>
        <td>{{ sw.server }}</td>
        <td class="num">{{ sw.loaded_count }}</td>
        <td class="num">{{ sw.called_count }}</td>
        <td class="num">{{ sw.unused_count }}</td>
        <td class="num">{{ sw.unused_tokens }}</td>
        <td>{% if sw.is_fully_unused %}<strong>yes</strong>{% else %}no{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <h3>Per-tool (top 20 unused, alphabetical)</h3>
  <table>
    <thead><tr><th>Tool</th><th>Server</th><th class="num">Calls</th><th class="num">Tokens</th><th>Source</th></tr></thead>
    <tbody>
      {% for t in tool_rows %}
      <tr>
        <td>{{ t.tool_name }}</td>
        <td>{{ t.server }}</td>
        <td class="num">{{ t.call_count }}</td>
        <td class="num">{{ t.tokens }}</td>
        <td>{{ t.source }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% if let Some(note) = footer_note %}
  <p class="footnote"><em>{{ note }}</em></p>
  {% endif %}
</section>
